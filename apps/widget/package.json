{
  "name": "@byteflock/widget",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:app",
      "scope:widget",
      "platform:lit"
    ],
    "targets": {
      "build": {
        "command": "node scripts/build.mjs",
        "options": {
          "cwd": "{projectRoot}"
        },
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/test-output/reports/build"
        ],
        "dependsOn": [
          "^build",
          "^typecheck"
        ],
        "cache": true
      }
    }
  },
  "dependencies": {
    "@byteflock/chat-widget": "workspace:*",
    "@byteflock/theme": "workspace:*",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@fontsource/source-sans-3": "5.3.1"
  }
}
