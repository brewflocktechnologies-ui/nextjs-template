{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "outDir": "out-tsc/playwright",
    "sourceMap": false,
    "types": ["node"],
    "lib": ["es2022", "dom", "dom.iterable"]
  },
  "include": [
    "src/tests/**/*.ts",
    "src/tests/**/*.js",
    "playwright.config.mts"
  ],
  "exclude": [
    "out-tsc",
    "test-output",
    "eslint.config.js",
    "eslint.config.mjs",
    "eslint.config.cjs"
  ]
}
