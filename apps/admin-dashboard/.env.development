# Development defaults for `next dev` (committed: no secrets). Override in .env.local.
# The session secret is the documented development default (D-12); production never reads it.
DEV_SESSION_SECRET=dev-only-secret-change-me
THEME_PUBLISH_DIR=../widget/public/v1
# Local Postgres (P2.1, ADR-012; start it with `pnpm db:up`). The non-owner role, so row-level security applies.
DATABASE_URL=postgres://byteflock_app:byteflock_app@localhost:5440/byteflock
NEXT_PUBLIC_WIDGET_ORIGIN=http://localhost:4400
NEXT_PUBLIC_DASHBOARD_ORIGIN=http://localhost:3000
# Test hook (P1.6-T09, T-03): the broken tenant's stored theme is a malicious fixture.
THEME_FIXTURE_OVERRIDE=t_broken=libs/theme/fixtures/malicious/css-injection-colour.json
