{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://byteflock.dev/schemas/theme-manifest.v1.json",
  "title": "Theme manifest v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "manifestVersion",
    "themeId",
    "displayName",
    "version",
    "contract",
    "source",
    "modes",
    "semanticMap"
  ],
  "properties": {
    "$schema": {
      "maxLength": 200,
      "type": "string"
    },
    "manifestVersion": {
      "const": 1,
      "type": "number"
    },
    "themeId": {
      "pattern": "^[a-z][a-z0-9-]{1,40}$",
      "type": "string"
    },
    "displayName": {
      "minLength": 1,
      "maxLength": 60,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "type": "string"
    },
    "version": {
      "pattern": "^(0|[1-9]\\d{0,5})\\.(0|[1-9]\\d{0,5})\\.(0|[1-9]\\d{0,5})$",
      "type": "string"
    },
    "contract": {
      "const": "platform-semantic-v1",
      "type": "string"
    },
    "source": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "format",
        "files"
      ],
      "properties": {
        "format": {
          "const": "dtcg-2025.10",
          "type": "string"
        },
        "producer": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "minLength": 1,
              "maxLength": 80,
              "type": "string"
            },
            "version": {
              "minLength": 1,
              "maxLength": 40,
              "type": "string"
            }
          }
        },
        "files": {
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^(?![a-zA-Z]:)(?!/)[^\\\\\\u0000-\\u001f]+$",
            "type": "string"
          }
        }
      }
    },
    "modes": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "light",
        "dark"
      ],
      "properties": {
        "light": {
          "minItems": 1,
          "maxItems": 200,
          "type": "array",
          "items": {
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^(?![a-zA-Z]:)(?!/)[^\\\\\\u0000-\\u001f]+$",
            "type": "string"
          }
        },
        "dark": {
          "minItems": 1,
          "maxItems": 200,
          "type": "array",
          "items": {
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^(?![a-zA-Z]:)(?!/)[^\\\\\\u0000-\\u001f]+$",
            "type": "string"
          }
        }
      }
    },
    "semanticMap": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9-]+(\\.[a-z0-9-]+)*$": {
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_$@{}-]+(\\.[A-Za-z0-9_$@{}-]+)*$",
          "type": "string"
        }
      }
    },
    "extensions": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "namespace",
        "tokens"
      ],
      "properties": {
        "namespace": {
          "pattern": "^[a-z][a-z0-9-]{1,40}$",
          "type": "string"
        },
        "tokens": {
          "type": "object",
          "patternProperties": {
            "^[a-z][a-z0-9-]{0,40}$": {
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_$@{}-]+(\\.[A-Za-z0-9_$@{}-]+)*$",
              "type": "string"
            }
          }
        }
      }
    },
    "fonts": {
      "maxItems": 20,
      "uniqueItems": true,
      "type": "array",
      "items": {
        "pattern": "^[a-z0-9-]{1,40}$",
        "type": "string"
      }
    }
  }
}
