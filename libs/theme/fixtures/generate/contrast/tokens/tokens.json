{
  "primitive": {
    "blue": {
      "300": {
        "$type": "color",
        "$value": "#93c5fd"
      },
      "600": {
        "$type": "color",
        "$value": "#2563eb"
      },
      "700": {
        "$type": "color",
        "$value": "#1d4ed8"
      }
    },
    "gray": {
      "0": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 1, 1]
        }
      },
      "100": {
        "$type": "color",
        "$value": "#f1f5f9"
      },
      "700": {
        "$type": "color",
        "$value": "#334155"
      },
      "900": {
        "$type": "color",
        "$value": "#111827"
      },
      "950": {
        "$type": "color",
        "$value": "#0f172a"
      }
    },
    "violet": {
      "600": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.541, 0.247, 293]
        }
      }
    }
  },
  "semantic": {
    "action": {
      "primary": {
        "$type": "color",
        "$value": {
          "$ref": "#/primitive/blue/700/$value"
        }
      },
      "on-primary": {
        "$type": "color",
        "$value": "#3b82f6"
      },
      "accent": {
        "$type": "color",
        "$value": "{primitive.violet.600}"
      },
      "on-accent": {
        "$type": "color",
        "$value": "#ffffff"
      }
    },
    "surface": {
      "default": {
        "$type": "color",
        "$value": "{primitive.gray.0}"
      },
      "variant": {
        "$type": "color",
        "$value": "{primitive.gray.100}"
      }
    },
    "text": {
      "default": {
        "$type": "color",
        "$value": "{primitive.gray.900}"
      },
      "muted": {
        "$type": "color",
        "$value": "{primitive.gray.700}"
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "#64748b"
      }
    },
    "status": {
      "success": {
        "$type": "color",
        "$value": "#15803d"
      },
      "warning": {
        "$type": "color",
        "$value": "#b45309"
      },
      "danger": {
        "$type": "color",
        "$value": "#b91c1c"
      }
    },
    "focus": {
      "ring": {
        "$type": "color",
        "$value": "{primitive.blue.600}"
      }
    },
    "font": {
      "body": {
        "$type": "fontFamily",
        "$value": ["Inter", "sans-serif"]
      }
    },
    "radius": {
      "medium": {
        "$type": "dimension",
        "$value": {
          "value": 12,
          "unit": "px"
        }
      }
    },
    "shadow": {
      "raised": {
        "$type": "shadow",
        "$value": {
          "color": "#0f172a26",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 2,
            "unit": "px"
          },
          "blur": {
            "value": 6,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      }
    },
    "scale": {
      "density": {
        "$type": "number",
        "$value": 1
      },
      "type": {
        "$type": "number",
        "$value": 1
      }
    },
    "brand": {
      "glow": {
        "$type": "color",
        "$value": "#f97316"
      }
    }
  }
}
