{
  "name": "@byteflock/design-tokens",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./css/semantic.css": "./src/generated/css/semantic.css",
    "./scales": "./src/generated/json/scales.json",
    "./package.json": "./package.json"
  },
  "nx": {
    "tags": [
      "type:lib",
      "scope:shared",
      "platform:neutral"
    ],
    "targets": {
      "build": {
        "command": "node scripts/build.mjs",
        "options": {
          "cwd": "{projectRoot}"
        },
        "inputs": [
          "{projectRoot}/tokens/**/*",
          "{projectRoot}/style-dictionary.config.mjs",
          "{projectRoot}/scripts/build.mjs"
        ],
        "outputs": [
          "{projectRoot}/src/generated"
        ],
        "cache": true
      },
      "build:check": {
        "command": "node scripts/build.mjs --check",
        "options": {
          "cwd": "{projectRoot}"
        },
        "inputs": [
          "{projectRoot}/tokens/**/*",
          "{projectRoot}/style-dictionary.config.mjs",
          "{projectRoot}/scripts/build.mjs",
          "{projectRoot}/src/generated/**/*"
        ],
        "cache": true
      },
      "test": {
        "dependsOn": [
          "build"
        ]
      }
    }
  },
  "dependencies": {},
  "devDependencies": {
    "style-dictionary": "5.7.1"
  }
}
