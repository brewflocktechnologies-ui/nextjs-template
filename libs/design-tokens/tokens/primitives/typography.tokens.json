{
  "primitive": {
    "font": {
      "family": {
        "system": {
          "$type": "fontFamily",
          "$value": [
            "system-ui",
            "-apple-system",
            "Segoe UI",
            "Roboto",
            "sans-serif"
          ]
        },
        "inter": {
          "$type": "fontFamily",
          "$value": ["Inter", "system-ui", "sans-serif"]
        },
        "roboto": {
          "$type": "fontFamily",
          "$value": ["Roboto", "system-ui", "sans-serif"]
        },
        "source-sans": {
          "$type": "fontFamily",
          "$value": ["Source Sans 3", "system-ui", "sans-serif"]
        },
        "noto-sans": {
          "$type": "fontFamily",
          "$value": ["Noto Sans", "system-ui", "sans-serif"]
        }
      },
      "size": {
        "xs": {
          "$type": "dimension",
          "$value": {
            "value": 12,
            "unit": "px"
          }
        },
        "sm": {
          "$type": "dimension",
          "$value": {
            "value": 14,
            "unit": "px"
          }
        },
        "md": {
          "$type": "dimension",
          "$value": {
            "value": 16,
            "unit": "px"
          }
        },
        "lg": {
          "$type": "dimension",
          "$value": {
            "value": 18,
            "unit": "px"
          }
        },
        "xl": {
          "$type": "dimension",
          "$value": {
            "value": 20,
            "unit": "px"
          }
        },
        "2xl": {
          "$type": "dimension",
          "$value": {
            "value": 24,
            "unit": "px"
          }
        }
      },
      "line-height": {
        "tight": {
          "$type": "number",
          "$value": 1.25
        },
        "normal": {
          "$type": "number",
          "$value": 1.5
        }
      },
      "weight": {
        "regular": {
          "$type": "fontWeight",
          "$value": 400
        },
        "medium": {
          "$type": "fontWeight",
          "$value": 500
        },
        "semibold": {
          "$type": "fontWeight",
          "$value": 600
        },
        "bold": {
          "$type": "fontWeight",
          "$value": 700
        }
      }
    }
  }
}
