{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":pinDigests"],
  "minimumReleaseAge": "7 days",
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "groupName": "nx",
      "matchPackageNames": ["nx", "@nx/**"]
    },
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true
    }
  ]
}
